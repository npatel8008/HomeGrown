# The scaffold runs fully offline with no values set. Everything below is
# optional and only turns on a richer implementation of one step.

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- IFM / K2 (services/llm_client.py) ---------------------------------
# With a key set, ingredient extraction is done by the model instead of the
# built-in keyword matcher. Every call falls back to the offline path on
# error, timeout, or unparseable output, so the demo cannot break.
# IFM_API_KEY=
# IFM_BASE_URL=https://api.ifm.ai/v1
# IFM_MODEL_STRUCTURED=IFM/K2-Think-v2              # anything that must parse
# IFM_MODEL_PROSE=IFM/K2-Horizon-375B-A23B          # free-text generation
# IFM_TIMEOUT=25
# GARDENAI_LLM_REASONS=0                            # 1 = LLM-written crop rationales

# --- Not yet wired up --------------------------------------------------
# OPENWEATHER_API_KEY=        # services/care_engine.py::get_weather
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
