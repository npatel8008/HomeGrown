# The scaffold runs fully offline with no values set. Everything below is
# optional and only turns on a richer implementation of one step.

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- IFM / K2 (services/llm_client.py) ---------------------------------
# With a key set, ingredient extraction is done by the model instead of the
# built-in keyword matcher. Every call falls back to the offline path on
# error, timeout, or unparseable output, so the demo cannot break.
# IFM_API_KEY=
# IFM_BASE_URL=https://api.ifm.ai/v1
# IFM_MODEL_STRUCTURED=IFM/K2-Think-v2              # anything that must parse
# IFM_MODEL_PROSE=IFM/K2-Horizon-375B-A23B          # free-text generation
# IFM_TIMEOUT=25
# GARDENAI_LLM_REASONS=0                            # 1 = LLM-written crop rationales

# --- Not yet wired up --------------------------------------------------
# OPENWEATHER_API_KEY=        # services/care_engine.py::get_weather
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# --- Per-account storage (MongoDB) -------------------------------------
# Without MONGODB_URI the app still runs; per-account saving is simply off
# and the frontend keeps using localStorage, saying so in the UI.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=gardenai
# MONGODB_TIMEOUT_MS=5000

# --- Who is calling (services/auth.py) ---------------------------------
# Must match the frontend. Pick ONE, and see frontend/.env.local.example.
#
# A) Auth0 API audience — the Identifier of an API registered in Auth0.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_API_AUDIENCE=https://api.gardenai.example.com
#
# B) Shared secret with the Next.js server (openssl rand -hex 32).
# INTERNAL_API_SECRET=
#
# With neither set, every /api/me/* route returns 503 rather than guessing
# who the caller is. That is deliberate: auth must fail closed.

# --- Voice control (services/elevenlabs_stt.py) ------------------------
# Speech-to-text for "add basil", "remove the kale", "six tomatoes".
# Without a key the endpoint returns 503 and the UI falls back to the
# browser's own speech recognition, then to a text box — the feature still
# works, it just stops being ElevenLabs.
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TIMEOUT=30
#
# Interpreting the transcript is deterministic (services/garden_voice.py) and
# needs no key. IFM_API_KEY above only adds a K2 fallback for phrasings the
# rules miss.
