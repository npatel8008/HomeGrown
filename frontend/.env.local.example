# Where the frontend sends API calls.
#
# Leave EMPTY for local development and phone testing: the app then makes
# same-origin requests (/api/...) and next.config.mjs proxies them to the
# FastAPI backend. One origin means one tunnel, no CORS, and no mixed-content
# surprises when the page is served over https.
#
# Set this to an absolute https:// URL only when the backend is deployed
# somewhere separate from the frontend.
#
# Do NOT set it to http://localhost:8000 — on any device that is not the one
# running the backend (i.e. a phone), that points at the device itself, the
# call fails, and the app silently serves bundled demo data.
NEXT_PUBLIC_API_URL=

# Where next.config.mjs proxies /api/* during development.
# BACKEND_ORIGIN=http://127.0.0.1:8000

# --- Auth0 -----------------------------------------------------------------
# Copy this file to .env.local and fill in values from an Auth0 Regular Web
# Application. Until these four are set, the app stays public (no login).
# Once they are set, onboarding / garden / today / account require a session.
#
# Auth0 Dashboard → Applications → Create Application → Regular Web Application
# Allowed Callback URLs:  http://localhost:3000/auth/callback
# Allowed Logout URLs:    http://localhost:3000
# Allowed Web Origins:    http://localhost:3000
#
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=          # openssl rand -hex 32
# APP_BASE_URL=http://localhost:3000
